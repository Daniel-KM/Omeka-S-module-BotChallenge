#: view/bot-challenge/index/index.phtml:26
msgid "Verifying your browser"
msgstr "Vérification du navigateur"

#: view/bot-challenge/index/index.phtml:129
msgid "JavaScript required"
msgstr "JavaScript requis"

#: view/bot-challenge/index/index.phtml:130
msgid "Please enable JavaScript in your browser to access this site."
msgstr "Veuillez activer JavaScript dans votre navigateur pour accéder à ce site."

#: view/bot-challenge/index/index.phtml:135
msgid "Verifying your browser…"
msgstr "Vérification du navigateur…"

#: view/bot-challenge/index/index.phtml:137
msgid "This is an automatic process. Please wait."
msgstr "Il s’agit d’un processus automatique. Veuillez patienter."

#: view/bot-challenge/index/index.phtml:141
#, php-format
msgid "Powered by %s"
msgstr "Propulsé par %s"

#: view/bot-challenge/index/index.phtml:175
msgid "Automated browser detected. Access denied."
msgstr "Navigateur automatisé détecté. Accès refusé."

#: view/bot-challenge/index/index.phtml:195
msgid "Verified. Redirecting…"
msgstr "Vérifié. Redirection…"

#: Module.php:130
#, php-format
msgid "Updating the ip ranges of the search engines in the background (job %s)."
msgstr "Mise à jour en arrière-plan des plages d’adresses ip des moteurs de recherche (tâche %s)."

#: src/Job/RefreshBotIps.php:47
msgid "BotChallenge: the source of {bot} is unreachable or empty ({url}): the bundled ranges are kept."
msgstr "BotChallenge : la source du {bot} est inaccessible ou vide ({url}) : les plages groupées sont conservées."

#: src/Job/RefreshBotIps.php:54
msgid "BotChallenge: the ranges of {bot} could not be written in {path}."
msgstr "BotChallenge : les plages de {bot} n’ont pas pu être écrites dans {path}."

#: src/Job/RefreshBotIps.php:61
msgid "BotChallenge: {total} ranges updated for {bot}."
msgstr "BotChallenge : mises à jour de {total} plages pour {bot}."

#: src/Job/RefreshBotIps.php:75
msgid "BotChallenge: {total} source(s) refreshed."
msgstr "BotChallenge : {total} source(s) actualisée(s)."

#: src/Form/ConfigForm.php:18
msgid "HMAC salt"
msgstr "Sel HMAC"

#: src/Form/ConfigForm.php:19
msgid "Secret salt used to generate challenge tokens. Leave empty to regenerate automatically. Changing this value invalidates all existing cookies."
msgstr "Sel secret utilisé pour créer des jetons de défi. Laisser vide pour le régénérer automatiquement. La modification de cette valeur invalide tous les cookies existants."

#: src/Form/ConfigForm.php:29
msgid "Challenge delay (seconds)"
msgstr "Délai du défi (secondes)"

#: src/Form/ConfigForm.php:30
msgid "Number of seconds the visitor must wait before the cookie is set."
msgstr "Nombre de secondes à attendre pour le visiteur vant de placer le cookie."

#: src/Form/ConfigForm.php:42
msgid "Cookie lifetime (days)"
msgstr "Durée de vie des cookies (jours)"

#: src/Form/ConfigForm.php:43
msgid "Number of days the challenge cookie remains valid."
msgstr "Nombre de jours pendant lesquels le cookie reste valide."

#: src/Form/ConfigForm.php:55
msgid "Detect headless browsers"
msgstr "Détecter les navigateurs sans tête"

#: src/Form/ConfigForm.php:56
msgid "Run additional tests to detect headless browsers (Selenium, PhantomJS, Puppeteer, etc.)."
msgstr "Exécuter des tests supplémentaires pour détecter les navigateurs sans tête (Selenium, PhantomJS, Puppeteer, etc.)."

#: src/Form/ConfigForm.php:66
msgid "Exception paths"
msgstr "Exceptions pour les chemins"

#: src/Form/ConfigForm.php:67
msgid "Url path prefixes to exclude from the challenge, one per line. Example: /api"
msgstr "Préfixes de chemins d’url à exclure du défi, un par ligne. Exemple : /api"

#: src/Form/ConfigForm.php:78
msgid "Exempted search engines"
msgstr "Moteurs de recherche exemptés"

#: src/Form/ConfigForm.php:79
msgid "Search engines whose published ip ranges are excluded from the challenge. Without exemption, they receive the javascript challenge, do not solve it, and stop indexing the site. The ranges are bundled with the module and may be updated with the job below."
msgstr "Les moteurs de recherche dont les plages d’adresses ip publiées sont exclues du défi. À moins d'une dérogation, ils reçoivent le défi JavaScript, ne le résolvent pas et cessent d’indexer le site. Ces plages sont intégrées au module et peuvent être mises à jour à l’aide de la tâche ci-dessous."

#: src/Form/ConfigForm.php:90
msgid "Update the ip ranges now"
msgstr "Mettre à jour les plages d'adresses ip maintenant"

#: src/Form/ConfigForm.php:91
msgid "Run a job to fetch the ip ranges from the sources of the search engines. A source that is unreachable or truncated is skipped and the bundled ranges are kept."
msgstr "Lancez une tâche pour récupérer les plages d’adresses ip à partir des sources des moteurs de recherche. Les sources inaccessibles ou incomplètes sont ignorées et les plages regroupées sont conservées."

#: src/Form/ConfigForm.php:101
msgid "Exception IPs"
msgstr "Exceptions pour les ips"

#: src/Form/ConfigForm.php:102
msgid "Ips v4 or v6 or cidr ranges to exclude from the challenge, one per line: the networks of the institution, a partner harvester, a specific bot. They are added to the ranges of the search engines above."
msgstr "Plages ip v4, v6 ou cidr à exclure du défi, une par ligne : les réseaux de l’établissement, d’un collecteur partenaire, d’un bot spécifique. Elles s’ajoutent aux plages des moteurs de recherche mentionnés ci-dessus."

