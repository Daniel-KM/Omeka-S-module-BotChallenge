<?php
/**
 * Card of a page for the link preview bots: its metadata only.
 *
 * The head contains the metadata added by the listeners of the modules that
 * manage them (MetaTags, ResourceMeta, Sharing). Without them, the main ones
 * are added from the resource, the page or the site.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation|null $previewResource
 * @var \Omeka\Api\Representation\SitePageRepresentation|null $previewPage
 */

$plugins = $this->getHelperPluginManager();
$escapeAttr = $plugins->get('escapeHtmlAttr');
$escape = $plugins->get('escapeHtml');
$headMeta = $plugins->get('headMeta');
$headTitle = $plugins->get('headTitle');

$url = $plugins->get('serverUrl')(true);
$title = strip_tags((string) $headTitle->renderTitle());

// The output escapes the attributes ("og&#x3A;title"), so check the items.
$hasOpenGraph = false;
foreach ($headMeta->getContainer() as $item) {
    if (($item->type ?? '') === 'property' && ($item->property ?? '') === 'og:title') {
        $hasOpenGraph = true;
        break;
    }
}

if (!$hasOpenGraph) {
    $site = $plugins->get('currentSite')();
    $previewResource ??= null;
    $previewPage ??= null;
    $description = '';
    $image = '';
    if ($previewResource) {
        $title = (string) $previewResource->displayTitle();
        $description = (string) $previewResource->displayDescription();
        $image = (string) $previewResource->thumbnailDisplayUrl('large');
    } elseif ($previewPage) {
        $title = (string) $previewPage->title();
    } elseif ($site) {
        $title = (string) $site->title();
        $description = (string) $site->summary();
    }
    $headMeta
        ->appendProperty('og:type', 'website')
        ->appendProperty('og:title', $title)
        ->appendProperty('og:url', $url)
        ->appendName('twitter:card', $image ? 'summary_large_image' : 'summary');
    if ($site) {
        $headMeta->appendProperty('og:site_name', (string) $site->title());
    }
    if ($description !== '') {
        $description = mb_substr(trim(preg_replace('~\s+~u', ' ', strip_tags($description))), 0, 300);
        $headMeta
            ->appendName('description', $description)
            ->appendProperty('og:description', $description);
    }
    if ($image !== '') {
        $headMeta->appendProperty('og:image', $image);
    }
}
// Keep the links of the metadata (oEmbed…), not the stylesheets of the modules.
$headLink = $plugins->get('headLink');
foreach ($headLink->getContainer()->getArrayCopy() as $key => $item) {
    if (($item->rel ?? '') === 'stylesheet') {
        $headLink->getContainer()->offsetUnset($key);
    }
}
?>
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <?= $headTitle ?>

    <?= $headMeta ?>

    <?= $headLink ?>

    <link rel="canonical" href="<?= $escapeAttr($url) ?>">
</head>
<body>
    <p><a href="<?= $escapeAttr($url) ?>"><?= $escape($title) ?></a></p>
</body>
</html>
